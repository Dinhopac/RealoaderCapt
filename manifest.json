{
  "manifest_version": 3,
  "name": "ReloaderCapt - Auto Reload & Monitor Pro",
  "short_name": "ReloaderCapt",
  "version": "3.2.0",
  "description": "Auto reload inteligente com captura CSS/XPath e monitoramento de alterações em páginas web.",
  "author": "DnX Software",

  "minimum_chrome_version": "102",

  "permissions": [
    "activeTab",
    "tabs",
    "storage",
    "scripting",
    "notifications",
    "alarms"
  ],

  "host_permissions": [
  "https://*/*",
  "http://*/*"
],

  "background": {
    "service_worker": "js/background.js"
  },

  "action": {
    "default_popup": "popup.html",
    "default_title": "ReloaderCapt Pro",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png"
    }
  },

  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },

  "content_scripts": [
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "js": [
        "js/content.js"
      ],
      "css": [
        "css/button.css"
      ],
      "run_at": "document_idle"
    }
  ],

  "web_accessible_resources": [
    {
      "resources": [
        "dashboard.html",
        "css/dashboard.css",
        "js/dashboard.js"
      ],
	"matches": [
  	"http://*/*",
  	"https://*/*"
	]
    }
  ],

  "commands": {
    "reload-now": {
      "suggested_key": {
        "default": "Alt+Shift+R",
        "mac": "Alt+Shift+R"
      },
      "description": "Recarregar a aba atual imediatamente"
    },

    "toggle-auto-reload": {
      "suggested_key": {
        "default": "Alt+Shift+A",
        "mac": "Alt+Shift+A"
      },
      "description": "Ativar ou desativar o Auto Reload na aba atual"
    }
  }
}